{
  "name": "corefeed-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @repo/db run db:generate && pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --recursive run lint",
    "test": "vitest run",
    "postinstall": "pnpm --filter @repo/db run db:generate",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,json,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "vitest": "^2.0.0",
    "@playwright/test": "^1.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
